{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-the-algorithm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // The origin the build bakes into canonical/og:url/og:image (SITE_URL in
  // shared/locales.ts). Deploying without it would publish to *.workers.dev while
  // those tags point elsewhere.
  "routes": [{ "pattern": "insidetheforyou.com", "custom_domain": true }],
  // Keeps that origin the only public host, instead of also answering on
  // *.workers.dev with the same HTML.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Locale paths such as /pt-br are client-side routes, not files.
    "not_found_handling": "single-page-application",
    // Serves /pt-br from dist/pt-br.html (the per-locale baseline written by the
    // locale-html plugin) with no redirect, and leaves every other path to the
    // SPA fallback above.
    "html_handling": "auto-trailing-slash",
    // The SPA fallback above matches any path that is not a file, so without
    // this the asset router could answer /api/* before the Worker ever runs.
    // `/api` on its own is not matched by `/api/*`, and would otherwise reach the
    // SPA fallback as a 200.
    "run_worker_first": ["/api", "/api/*"]
  },
  "ratelimits": [
    {
      // Per-visitor limit for /api/name
      "name": "NAME_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Global backstop across all visitors, bounds total spend
      "name": "NAME_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
